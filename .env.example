# Google Gemini API Key for scientific reasoning and embeddings
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Application hosting URL (injected automatically in cloud environments)
APP_URL="http://localhost:3000"

# Local SQLite Database URL
DATABASE_URL="sqlite:///./data/darukaa.db"

# Persistent ChromaDB Vector Store Path
CHROMA_PATH="./chroma_db"

# Runtime Environment (development / production / test)
APP_ENV="development"
